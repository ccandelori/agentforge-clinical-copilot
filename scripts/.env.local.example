# Local-only deploy/dev config for scripts/.
#
# Copy to scripts/.env.local (gitignored) and edit. The deploy script
# auto-sources scripts/.env.local at startup, so values set here become
# the defaults for `./scripts/deploy-droplet.sh` invocations from this
# checkout. Anything set in your shell environment still wins.
#
#   cp scripts/.env.local.example scripts/.env.local
#   $EDITOR scripts/.env.local

# SSH target for the production droplet (REQUIRED by deploy-droplet.sh).
# Format: user@host. Key auth is assumed.
# DROPLET_HOST=root@your-droplet.example.com

# Optional overrides — defaults in deploy-droplet.sh match the
# development-easy compose stack and the canonical sidecar container name.
# OPENEMR_CONTAINER=development-easy-openemr-1
# OPENEMR_NETWORK=development-easy_default
# SIDECAR_NAME=agentforge-sidecar
