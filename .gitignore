# logs
/logs

# environment vars
.env

# vendor and assets
node_modules
/vendor/*
/public/assets/*
/public/themes/*
!/public/assets/modified
/.docs/.out/*

# ccda service build
ccdaservice/node_modules

# dev editor configs
/.idea/*
/.vscode/*
/.vscode-oss/*
/nbproject/*
.DS_Store
.buildpath
.project
.settings

# testing
.phpunit.result.cache

# dev tool local overrides
phpcs.xml
phpstan.neon
coverage/js-unit

# phpstan
tmp-phpstan/*

# easy dev worktree support
.worktrees.json
docker/development-easy/docker-compose.override.yml
docker/development-easy-light/docker-compose.override.yml
docker/development-easy-redis/docker-compose.override.yml

# AgentForge sidecar Redis bind-mount data (Task 30)
docker/development-easy/redis-data/

# ============================================================================
# AgentForge — local-only artifacts (per-machine, never committed)
# ============================================================================

# AI agent / linter / language-server tool state (personal tooling)
/.claude/
/.clj-kondo/
/.learning/
/.lsp/

# Taskmaster runtime state — per-machine (current-tag pointer + last-switched
# timestamp). Task data and PRDs under .taskmaster/ ARE committed; only the
# transient state pointer is ignored.
/.taskmaster/state.json

# PHPStan / pytest / eval ad-hoc output dumps
/.phpstan-*
/phpstan-*.txt
/phpstan-*.out
docs/eval-baseline-*.txt
docs/eval-baseline-*.json

# OpenEMR per-install secrets — never committed
sites/default/documents/certificates/*.key
sites/default/documents/certificates/*.pem

# OpenEMR runtime artifacts under logs_and_misc — generated, regenerable
sites/default/documents/logs_and_misc/methods/sevena
sites/default/documents/logs_and_misc/methods/sevenb

# OpenEMR runtime document storage — encrypted patient uploads, not source
# (numeric per-document directories created by the upload flow)
sites/default/documents/[0-9]*/

# Local-only deploy/dev config (DROPLET_HOST, etc.) — see scripts/.env.local.example
scripts/.env.local
