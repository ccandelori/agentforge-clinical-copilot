# vue-ui environment template — copy to .env.development.local
# (gitignored) and adjust for your local dev stack.
#
# VITE_SIDECAR_BASE: the AgentForge sidecar base URL. The Vite dev
# server proxies /auth/* and /api/* to this origin so cookies ride
# same-origin. In production (T38.14) the SPA is served from the
# sidecar host so the proxy is irrelevant — this only matters for
# `npm run dev`.
#
# Local sidecar — recommended dev workflow is `cd sidecar && ./scripts/sidecar.sh start`
# which runs uvicorn on 127.0.0.1:8000 with `sidecar/.env` (loaded by pydantic-settings).
# Alternative: docker/agent/docker-compose.yml publishes on
# 127.0.0.1:${AGENT_SIDECAR_PORT:-8400} but the OAuth token-exchange leg
# fails from inside the container because OpenEMR's /oauth2/* endpoint
# at https://localhost:9300 is host-only-reachable.
VITE_SIDECAR_BASE=http://localhost:8000
