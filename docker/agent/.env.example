# AgentForge sidecar — docker/agent stack environment template.
#
# Copy to `docker/agent/.env` and fill in real values. The compose
# stack reads this file via env_file. Production deployments override
# at the orchestrator (Kubernetes, Compose on the droplet) — this
# file is dev-only.

# --- Required ---

# 32+ byte symmetric secret for JWT minting + validation. The VALUE
# must match AGENTFORGE_JWT_SECRET in
# interface/modules/custom_modules/oe-module-agentforge/.env so the
# OpenEMR PHP module mints tokens the sidecar can verify. The
# sidecar reads it as JWT_SECRET (no prefix); the PHP module reads
# it as AGENTFORGE_JWT_SECRET. Same value, two names — convention
# difference between the Python-settings and PHP-Dotenv layers.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-shared-jwt-secret

# 32+ byte HMAC key for pseudonymizing user/patient IDs in Langfuse
# traces. Rotate quarterly per ARCHITECTURE.md §7.2.
# Generate with: openssl rand -base64 32
HMAC_KEY=replace-me-with-32-random-bytes

# Anthropic API key for the LLM. The sidecar refuses to start with
# llm_provider=claude and an empty key (deferred LLM error becomes a
# load-time error in production-shaped runs).
ANTHROPIC_API_KEY=

# --- Service URLs (use the dev-easy service names; the agent stack
# joins development-easy_default so these resolve internally) ---

# OpenEMR base URL the sidecar uses for the JWT-authenticated PHP
# internal endpoints (get_active_problems, get_recent_labs, etc.).
OPENEMR_BASE_URL=http://openemr:80

# Redis URL (tool result cache + session memory). The compose stack
# provides its own `agentforge-redis` service so the agent stack is
# self-contained — naming matches the production droplet.
REDIS_URL=redis://agentforge-redis:6379/0

# --- Langfuse (optional; leave keys blank to use NullLangfuseClient) ---

LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Verifier + sensitivity policy ---

# Streaming verifier on the user-visible reply. Off by default in
# dev so test fixtures and demo mode don't depend on perfectly-cited
# responses; production sets VERIFIER_ENABLED=true.
VERIFIER_ENABLED=false

# Sensitivity policy required at startup. Off in dev because the
# bundled YAML path doesn't always resolve inside docker images
# (NEXT-SESSION carryforward #1). Production sets this to true.
SENSITIVITY_POLICY_REQUIRED=false
