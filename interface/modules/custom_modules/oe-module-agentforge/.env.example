# AgentForge module environment variables.
#
# Copy to `.env` (same directory) and fill in real values. The PHP entry
# points (public/turn.php, public/internal/*.php) read this file via
# OpenEMR\Modules\AgentForge\EnvLoader at request time. Production
# deployments can instead set the same vars at the container/process
# level — if the value is already in the environment when EnvLoader
# runs, the .env value does not override it.

# 32+ byte symmetric secret for JWT minting + validation.
# Generate with: openssl rand -base64 32
AGENTFORGE_JWT_SECRET=

# Sidecar base URL the AgentProxyController forwards user turns to.
# In docker compose this is the sidecar service name; locally it's a
# host port.
AGENTFORGE_SIDECAR_URL=http://host.docker.internal:8000
