{#
The AgentForge Clinical Co-Pilot chat panel.

Renders inside the patient summary view as a card containing the conversational
agent interface. The browser-side JS (public/js/) binds this card to the
sidecar's /agentforge/turn endpoint, capturing patient_id from the chart
context. The card body is the chat surface; the agent is bound to the active
patient for the lifetime of the panel.

Expected variables (provided by the controller in Task 2):
- id: DOM id for the collapsible card body
- title: card title (e.g. "Clinical Co-Pilot")
- auth: bool, whether the user can interact with the agent
- card: card object exposing canAdd()/canEdit()
- forceAlwaysOpen, initiallyCollapsed, btnLink, btnClass, linkMethod, btnLabel,
  requireRestore: see card_base.html.twig

@package OpenEMR
@subpackage Modules
@author Cameron Candelori <cameron.candelori@challenger.gauntletai.com>
@copyright Copyright (c) 2026 Cameron Candelori
@license https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3
#}
{% extends "patient/card/card_base.html.twig" %}

{% block content %}
    <div class="agentforge-panel d-flex flex-column" data-module="oe-module-agentforge"
         data-turn-url="/interface/modules/custom_modules/oe-module-agentforge/public/turn.php"
         data-upload-url="/interface/modules/custom_modules/oe-module-agentforge/public/upload_document.php">
        {# Chat surface is rendered by public/js/ on mount. #}
        <div class="agentforge-messages border rounded p-2 mb-2 bg-light"
             data-role="messages"
             style="height: 320px; overflow-y: auto;">
            <div class="text-muted small" data-role="empty-state">
                {{ "Ask the Co-Pilot a question about this patient."|text }}
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="agentforge-status small text-muted" data-role="status" hidden>
                {{ "Thinking…"|text }}
            </div>
            <button type="button"
                    class="btn btn-link btn-sm p-0 ml-auto small"
                    data-role="new-conversation"
                    title="{{ "Start a new conversation; the Co-Pilot will not remember previous messages."|attr }}">
                {{ "New conversation"|text }}
            </button>
        </div>
        {# W2 upload + guidelines row (MR 7). The hidden file input is fanned-out
           by the visible button so we control its styling. The pending-doc
           indicator surfaces the attached document_id between upload and
           the next /turn send so the user can confirm what they're about
           to send. #}
        <div class="d-flex align-items-center mb-2 small">
            <input type="file"
                   data-role="upload-input"
                   accept="application/pdf"
                   hidden>
            <button type="button"
                    class="btn btn-outline-secondary btn-sm mr-2"
                    data-role="upload-button"
                    title="{{ "Attach a PDF intake form for extraction."|attr }}">
                {{ "Attach intake form"|text }}
            </button>
            <span class="text-muted mr-3"
                  data-role="pending-doc-indicator"
                  hidden></span>
            <label class="form-check-label mb-0 ml-auto"
                   title="{{ "Search the bundled clinical-guideline corpus when sending the next message."|attr }}">
                <input type="checkbox"
                       class="form-check-input"
                       data-role="guidelines-toggle">
                {{ "Search guidelines"|text }}
            </label>
        </div>
        <form class="agentforge-form" data-role="form" autocomplete="off">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       data-role="input"
                       placeholder="{{ "Type a message…"|attr }}"
                       aria-label="{{ "Message to Clinical Co-Pilot"|attr }}">
                <div class="input-group-append">
                    <button type="submit" class="btn btn-primary" data-role="send">
                        {{ "Send"|text }}
                    </button>
                </div>
            </div>
        </form>
    </div>
    {#
        pdf.js loader. pdf.js 5.x is ESM-only — even the legacy build ships
        as .mjs modules that cannot be loaded via classical <script src>.
        We import the namespace inside a module script, configure the worker
        URL, and re-expose the API on `window.pdfjsLib` so the citation
        overlay (Task 24, public/js/citation_overlay.js) and any other
        IIFE-style consumer can find it under the symbol name from pdf.js
        4.x and earlier. A `agentforge:pdfjs-ready` event fires once the
        global is set so consumers can wait if their own load order
        races the deferred module script.
        See docs/DEVIATIONS.md (2026-05-06) for the npm/ESM rationale.
    #}
    <script type="module">
        import * as pdfjsLib from "/public/assets/pdfjs-dist/legacy/build/pdf.min.mjs";
        pdfjsLib.GlobalWorkerOptions.workerSrc =
            "/public/assets/pdfjs-dist/legacy/build/pdf.worker.min.mjs";
        window.pdfjsLib = pdfjsLib;
        window.dispatchEvent(new CustomEvent("agentforge:pdfjs-ready"));
    </script>
    <script src="/interface/modules/custom_modules/oe-module-agentforge/public/js/agent_panel.js"></script>
    <script src="/interface/modules/custom_modules/oe-module-agentforge/public/js/citation_overlay.js"></script>
{% endblock %}
