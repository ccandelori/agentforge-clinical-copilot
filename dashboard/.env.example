# AgentForge Dashboard — environment template.
#
# Copy to .env.development.local (gitignored) for local dev. The
# dashboard talks to OpenEMR exclusively through the AgentForge sidecar
# BFF — confidential OAuth2 client credentials live in `sidecar/.env`,
# not here. The dashboard itself is a public SPA and holds no secrets.

# AgentForge sidecar URL — the dashboard's API origin in dev. Vite's
# server.proxy block forwards /auth/* and /api/* to this host so the
# browser sees same-origin requests (cookies ride along automatically).
# Production (T38.14) serves the dashboard from the sidecar host so
# this is unused there.
VITE_SIDECAR_BASE=http://localhost:8000
