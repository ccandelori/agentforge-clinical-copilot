# OpenEMR base URL the dashboard talks to. Local dev-easy is
# http://localhost:8300; production droplet is http://143.244.157.90:9300.
VITE_OPENEMR_BASE_URL=http://localhost:8300

# OAuth2 / OpenID Connect client registered with OpenEMR.
# OpenEMR exposes /oauth2/<site>/{authorize,token,userinfo,jwks}.
# Register the client (Authorization Code + PKCE) in OpenEMR's
# admin → Client Registrations panel and copy the values here.
VITE_OPENEMR_OAUTH_CLIENT_ID=
VITE_OPENEMR_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OPENEMR_OAUTH_SCOPES=openid fhirUser patient/*.read patient/*.write
