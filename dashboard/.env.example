# AgentForge Dashboard — environment template
#
# Copy to `.env.development.local` (gitignored) for local dev, then fill in
# the values produced by your OpenEMR client registration. Vite exposes any
# variable prefixed `VITE_` to the browser bundle.
#
# OpenEMR registration walkthrough lives in PATIENT_DASHBOARD_MIGRATION.md.

# OpenEMR base URL (where the OAuth2 + FHIR endpoints live).
# dev-easy: https://localhost:9300 (HTTPS — OAuth2 endpoints require it).
# droplet:  http://143.244.157.90:9300 (or whatever the deploy lands on).
VITE_OPENEMR_BASE=https://localhost:9300

# OpenEMR site identifier — typically `default`.
VITE_OPENEMR_SITE=default

# Public OAuth2 client (PKCE only, no client_secret) registered against
# OpenEMR via `POST /oauth2/<site>/registration` with
# `application_type: "public"`. See PATIENT_DASHBOARD_MIGRATION.md for the
# exact curl. Must be enabled in Admin → System → API Clients before use.
VITE_OAUTH_CLIENT_ID=replace-me

# Where OpenEMR redirects after a successful (or failed) authorization.
# Vite dev server defaults to port 5173.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Space-delimited OAuth2/SMART-on-FHIR scopes. Patient-context only — public
# clients on OpenEMR cannot request user/* or system/* scopes. Writes
# (T38.12) will pivot to OpenEMR's REST API since FHIR write scopes are not
# advertised in dev-easy's OAuth2 metadata.
VITE_OAUTH_SCOPE="openid offline_access fhirUser patient/Patient.read patient/AllergyIntolerance.read patient/Condition.read patient/MedicationRequest.read patient/CareTeam.read patient/Observation.read"

# OAuth2 audience claim — OpenEMR-specific extension that binds the access
# token to a particular resource server. Required by the authorize endpoint.
VITE_OAUTH_AUDIENCE=https://localhost:9300/apis/default/fhir
