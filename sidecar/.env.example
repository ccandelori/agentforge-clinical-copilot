# AgentForge sidecar configuration template.
# Copy to .env and fill in real values for local development.
# Production values come from the deployment's secret store, not from .env.

# Application
APP_NAME="AgentForge Clinical Co-Pilot"
DEBUG=false

# JWT — must match the secret the OpenEMR PHP module uses to mint tokens
JWT_SECRET=replace-with-a-strong-shared-secret
JWT_ALGORITHM=HS256

# Redis (tool result cache + session memory)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=4500
TOOL_CACHE_TTL_SECONDS=60

# LLM providers (only the active provider's key needs a real value)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VLLM_BASE_URL=

# OpenEMR integration
OPENEMR_BASE_URL=http://localhost:80
OPENEMR_FHIR_ENDPOINT=/apis/fhir/r4
OPENEMR_INTERNAL_ENDPOINT=/agentforge/internal

# Langfuse observability (engineering traces; HMAC-pseudonymous, never PHI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# HMAC key for pseudonymizing user/patient IDs in Langfuse traces.
# Must be at least 32 random bytes (e.g. `openssl rand -base64 32`).
# Rotate quarterly per ARCHITECTURE.md §7.2.
HMAC_KEY=replace-with-32-random-bytes-base64

# Dashboard BFF (Task 38.2 v2). The Vue dashboard at /dashboard talks
# to OpenEMR through the sidecar's /auth/* + /api/fhir/* routes. The
# sidecar holds the confidential OAuth2 client_secret server-side so
# it never ships to the browser. Register the client via:
#   POST {OPENEMR_HTTPS}/oauth2/{site}/registration
#   { "application_type": "private",
#     "token_endpoint_auth_method": "client_secret_post",
#     "redirect_uris": ["http://localhost:5173/auth/callback"],
#     "scope": "openid offline_access fhirUser user/Patient.read ..." }
# Then enable in OpenEMR admin → System → API Clients.
DASHBOARD_OAUTH_AUTHORITY=https://localhost:9300/oauth2/default
DASHBOARD_OAUTH_CLIENT_ID=
DASHBOARD_OAUTH_CLIENT_SECRET=
DASHBOARD_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
DASHBOARD_OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
DASHBOARD_OAUTH_AUDIENCE=https://localhost:9300/apis/default/fhir
DASHBOARD_APP_URL=http://localhost:5173/
DASHBOARD_FHIR_BASE_URL=https://localhost:9300/apis/default/fhir
DASHBOARD_SESSION_COOKIE_NAME=agentforge_session
DASHBOARD_SESSION_TTL_SECONDS=28800
DASHBOARD_PENDING_AUTH_TTL_SECONDS=600
DASHBOARD_SESSION_COOKIE_SECURE=false
